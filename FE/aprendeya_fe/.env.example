# Copiar a .env.local para no versionarlo (ver .gitignore).

# Backend simulado (ver src/mocks/README.md). Por default está activo, así
# el deploy de solo-FE funciona sin ningún backend corriendo. Poner "false"
# acá para volver a pegarle al backend real de Django en localhost:8000.
VITE_USE_MOCK_API=true

# Credenciales de EmailJS para el envío del correo de recuperación de
# contraseña (ver src/auth/components/ResetPassword.jsx). No relacionadas
# con el mock: EmailJS es un servicio externo real y sigue llamándose tal
# cual, aun con el backend simulado activo.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
